# Leave VITE_FACTORY empty to run the in-browser demo (no wallet, no chain).
VITE_FACTORY=
VITE_CHAIN_ID=
VITE_CHAIN_NAME=Monad
VITE_RPC_URL=
VITE_EXPLORER=
# Block the factory was deployed at (log scans start here)
VITE_FACTORY_BLOCK=0
# An allowlisted validator id for "let it grow"; 0 hides growing
VITE_VALIDATOR_ID=0
# Native tip per keeper step, in wei (default 0.01 MON)
VITE_TIP_WEI=10000000000000000
# Optional: the keeper's /status URL, for the reliability line on schedule pages
VITE_KEEPER_URL=
# 1 adds an "in a few minutes" option, to show a real delivery live
VITE_DEMO=0
